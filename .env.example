# MySQL runs directly on your VM. Use the database VM address if it is separate.
# ASP.NET Core configuration uses a separate MySQL connection string.
ConnectionStrings__MySql=Server=172.31.4.5;Port=3306;Database=astra;User ID=astra_app;Password=REPLACE_ME;Connection Timeout=5
# Optional existing private Microsoft identity settings. Keep this file outside source control.
ASTRA_PRIVATE_RUNTIME_SETTINGS_FILE=
APP_BASE_URL=http://localhost:3200
# Enable only after registering http://localhost:3200/api/auth/callback as a Web redirect URI.
ASTRA_AUTH_CALLBACK_READY=false
# Local preview only; ignored outside Development and for non-loopback requests.
ASTRA_LOCAL_TEST_LOGIN=false
# Optional additional localhost origins for forwarded preview ports (comma separated).
ASTRA_LOCAL_PREVIEW_ORIGINS=
# Email workers operate only when email is enabled in Administration.
ASTRA_MAIL_WORKER_ENABLED=true
ASTRA_MAIL_INBOUND_ENABLED=true
# Optional 64-character hexadecimal encryption key; the selected private runtime
# settings file's mailConfigKey is used when this is empty.
MAIL_CONFIG_KEY=
# Optional general documentation search. Never commit a provider key.
WEB_GUIDANCE_ENABLED=false
WEB_GUIDANCE_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
WEB_GUIDANCE_SEARXNG_URL=

# Optional isolated verification server; requires CREATE/DROP DATABASE privileges.
# Never use production credentials for checks. Keep the value private.
ASTRA_TEST_MYSQL_CONNECTION=
