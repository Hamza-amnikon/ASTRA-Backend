# MySqlConnector connection string; keep the password only in private runtime.env.
export MYSQL_CONNECTION_STRING='Server=172.31.4.5;Port=3306;Database=astra_ticketing;User ID=astra_app;Password=;SSL Mode=Required;'
export REDIS_URL=''
export ENTRA_CLIENT_ID=''
export ENTRA_CLIENT_SECRET=''
export ENTRA_TENANT_ID=''
export INITIAL_ADMIN_OBJECT_IDS=''
export DATA_PROTECTION_KEY_DIRECTORY=''
